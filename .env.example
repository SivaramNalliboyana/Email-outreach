# Copy this file to `.env` and fill in your Google OAuth credentials.
# Get these from console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth-callback

# Leave blank — gets filled in automatically the first time you visit /api/auth.
GMAIL_REFRESH_TOKEN=

PORT=3000
