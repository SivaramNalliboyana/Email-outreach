# Copy this file to `.env` and fill in your credentials.

# --- Google OAuth (Gmail / Workspace sender) ---
# Get these from console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth-callback

# Leave blank — gets filled in automatically the first time you visit /api/auth.
GMAIL_REFRESH_TOKEN=

# Optional: override the From header on Gmail sends, e.g. "Your Name <you@workspace-domain.com>"
# GMAIL_FROM=

# --- IONOS SMTP (second sender, optional) ---
# Leave blank to disable the IONOS option. Quote the password if it contains # $ or spaces.
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=""
SMTP_FROM=Your Name <you@yourdomain.com>

# --- Server ---
PORT=3000
